# Docker Compose reads .env automatically. For local Go commands, export these.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=order-management
JWT_TOKEN_TTL=24h
POSTGRES_PASSWORD=orders_local
DATABASE_URL=postgres://orders:orders_local@127.0.0.1:5432/orders?sslmode=disable
HTTP_ADDRESS=:8080
# Optional assertion/initialization override; empty uses persisted base or fresh region default.
CURRENCY=
STORE_REGION=US
QUOTE_TTL=5m
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_RATE_WINDOW=1m
AUTH_RATE_MAX_KEYS=10000
AUTH_MAX_IN_FLIGHT=4
PROCESSING_INTERVAL=5m
PROCESSING_BATCH_SIZE=500
